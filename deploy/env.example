# Запасные настройки ассистента. Основной способ: Настройки → Ассистент → «Настроить подключение» в приложении
# (то, что задано там, главнее этого файла). Файл читается при запуске: после правок выполни
#   systemctl --user restart workout

# --- Облачная модель (по умолчанию Anthropic) ---
ANTHROPIC_API_KEY=
# ASSISTANT_CLOUD_MODEL=claude-sonnet-5-5

# Другой облачный провайдер с OpenAI-совместимым API (OpenAI, OpenRouter и т.п.):
# ASSISTANT_CLOUD_PROVIDER=openai
# ASSISTANT_CLOUD_BASE_URL=https://api.openai.com/v1
# ASSISTANT_CLOUD_API_KEY=
# ASSISTANT_CLOUD_MODEL=

# --- Локальная модель (Ollama) ---
# ASSISTANT_LOCAL_URL=http://127.0.0.1:11434/v1
# Если не задано, берётся первая установленная в Ollama модель.
# Для вызова инструментов нужна модель, которая это умеет (например, семейства qwen или llama 3.1+).
# ASSISTANT_LOCAL_MODEL=

# --- Локальный агент (OpenAI-совместимый API) ---
# ASSISTANT_AGENT_URL=http://127.0.0.1:8080/v1
# ASSISTANT_AGENT_TOKEN=
# ASSISTANT_AGENT_MODEL=

# --- Сеть ---
# По умолчанию сервер слушает только 127.0.0.1 и открывается наружу через Tailscale (HTTPS).
# Чтобы открыть его в локальной сети (по HTTP!) и опубликовать через mDNS, раскомментируй:
# WORKOUT_HOST=0.0.0.0
# WORKOUT_MDNS=1
# WORKOUT_PORT=8000
# Если автоопределение адреса ошибается, задай нужный адрес вручную:
# PUBLIC_URL=https://pc.tailnet.ts.net
# Свои имена хоста через запятую (по умолчанию разрешены localhost, частные IP, *.ts.net, *.local):
# WORKOUT_ALLOWED_HOSTS=pc.lan
# НЕ используй `tailscale funnel`: он открывает сервер всему интернету.

# --- Комната «Рядом» и друзья ---
# Адрес сигнального релея (WebSocket). Тот же адрес нужно задать при сборке клиента: VITE_ROOM_RELAY_URL=wss://relay.example
# Без него раздел остаётся в приложении, но создать комнату и добавить друга по коду нельзя (файловый обмен снимками работает).
# WORKOUT_ROOM_RELAY_URL=wss://relay.example
