{
  "name": "repforge",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "build:public": "vite build && node scripts/gen-headers.mjs",
    "test:relay": "cd relay && npm test",
    "build:native": "tsc -b && vite build --mode native",
    "cap:sync": "npm run build:native && cap sync android && node scripts/native-android-config.mjs",
    "cap:sync:lan": "VITE_ALLOW_LAN_HTTP=1 npm run cap:sync",
    "android:debug": "cd android && ./gradlew assembleDebug",
    "native:assets": "node scripts/make-native-assets.mjs && capacitor-assets generate --android --assetPath assets --iconBackgroundColor \"#12161c\" --iconBackgroundColorDark \"#12161c\" --splashBackgroundColor \"#12161c\" --splashBackgroundColorDark \"#12161c\"",
    "android:release": "cd android && ./gradlew assembleRelease",
    "android:bundle": "cd android && ./gradlew bundleRelease"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^8.0.1",
    "@capacitor-community/background-geolocation": "^1.3.1",
    "@capacitor-community/bluetooth-le": "^8.3.0",
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor-mlkit/barcode-scanning": "^8.2.1",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/geolocation": "^8.2.4",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.3",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^1.1.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.6.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "fake-indexeddb": "^6.2.6",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vite-plugin-pwa": "^0.20.5",
    "vitest": "^2.1.9",
    "workbox-window": "^7.4.1"
  }
}
